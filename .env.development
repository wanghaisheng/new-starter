# 开发环境配置
NEXT_PUBLIC_DATABASE_ENV=development
NEXT_PUBLIC_DATABASE_URL=sqlite://./data/development.db
NEXT_PUBLIC_MOCK_DB_TYPE=mock
NEXT_PUBLIC_DB_NAME=app_database_mock
NEXT_PUBLIC_DB_VERSION=1
NEXT_PUBLIC_USE_FAKE_INDEXEDDB=true

# 认证系统配置
NEXT_PUBLIC_AUTH_SERVICE_TYPE=better  # better, firebase
NEXT_PUBLIC_BETTER_AUTH_API_KEY=dev_api_key
NEXT_PUBLIC_BETTER_AUTH_API_URL=http://localhost:3001/api/auth

# Firebase 认证配置（如果使用 Firebase）
NEXT_PUBLIC_FIREBASE_API_KEY=dev_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=dev-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=dev-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=dev-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# 数据库调试配置
NEXT_PUBLIC_DB_DEBUG=true
NEXT_PUBLIC_DB_LOG_LEVEL=debug

# 性能监控配置
NEXT_PUBLIC_DB_PERFORMANCE_MONITOR=true
NEXT_PUBLIC_DB_QUERY_TIMEOUT=5000

# 数据同步配置（Mock 环境禁用）
NEXT_PUBLIC_DB_SYNC_ENABLED=false
NEXT_PUBLIC_DB_SYNC_INTERVAL=0

# 离线存储配置（使用fake-indexeddb模拟）
NEXT_PUBLIC_OFFLINE_STORAGE_TYPE=mock-indexeddb
NEXT_PUBLIC_OFFLINE_STORAGE_NAME=app_db_dev
NEXT_PUBLIC_OFFLINE_STORAGE_VERSION=1

# JSON 存储配置（用于MockDatabaseClient的持久化）
NEXT_PUBLIC_MOCK_DB_JSON_PATH=./data/mock-db.json
NEXT_PUBLIC_MOCK_DB_AUTOSAVE=true
NEXT_PUBLIC_MOCK_DB_PERSISTENCE=json

# API 配置
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_API_VERSION=v1

# 认证配置
NEXT_PUBLIC_AUTH_SECRET=your-auth-secret
NEXT_PUBLIC_JWT_SECRET=your-jwt-secret

# 应用配置
NEXT_PUBLIC_APP_NAME=HeyTCM
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_ENV=development

# 日志配置
NEXT_PUBLIC_LOG_LEVEL=debug
NEXT_PUBLIC_ENABLE_DEBUG=true

# 测试配置
NEXT_PUBLIC_ENABLE_TEST_MODE=true
NEXT_PUBLIC_TEST_USER_ID=test-user-123 