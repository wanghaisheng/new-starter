# 开发环境配置
NODE_ENV=development
AUTH_TYPE=mock

# Firebase 相关（如需本地联调时填写）
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# API
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_API_ENV=mock
NEXT_PUBLIC_PLATFORM=web

# 数据库/同步/降级策略
ENABLE_OFFLINE=true
ENABLE_HYBRID=false
ONLINE_STORAGE_TYPE=mock
OFFLINE_STORAGE_TYPE=indexeddb
SYNC_ENABLED=true
SYNC_STRATEGY=periodic
CONFLICT_RESOLUTION=server-wins

# Mock/测试
USE_MOCK_NETWORK=true
USE_MOCK_DB=true
LOAD_TEST_DATA=false
TEST_DATA_SOURCE=example

# 版本/构建信息
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_BUILD_NUMBER=dev

# 其它
CDN_BASE_URL=
NEXT_PUBLIC_FEATURE_FLAG_NEW_CHAT=false
