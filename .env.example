# 基础环境
NODE_ENV=development

# 配置服务 Provider（核心，决定所有服务注册与适配策略）
# 可选值：env | mock | remote | default | localfile | consul | etcd | ssm
NEXT_PUBLIC_CONFIG_PROVIDER=env

# 认证服务供应商
NEXT_PUBLIC_AUTH_SERVICE_TYPE=mock

# 用户/消息/通知/支付/测验等服务类型
NEXT_PUBLIC_USER_SERVICE_TYPE=mock
NEXT_PUBLIC_MESSAGE_SERVICE_TYPE=mock
NEXT_PUBLIC_NOTIFICATION_SERVICE_TYPE=mock
NEXT_PUBLIC_PAYMENT_SERVICE_TYPE=revenuecat
NEXT_PUBLIC_QUIZ_SERVICE_TYPE=mock

# 在线存储环境与供应商
NEXT_PUBLIC_DATABASE_ENV=local
NEXT_PUBLIC_DATABASE_PROVIDER=mock
NEXT_PUBLIC_OFFLINE_DB_TYPE=indexeddb

# Firebase 相关
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# API 相关
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_ENV=local
NEXT_PUBLIC_PLATFORM=web
NEXT_PUBLIC_QUIZ_API_BASE_URL=
NEXT_PUBLIC_QUIZ_AI_BASE_URL=

# 同步/降级策略
NEXT_PUBLIC_ENABLE_OFFLINE=true
NEXT_PUBLIC_ENABLE_HYBRID=false
NEXT_PUBLIC_SYNC_ENABLED=true
NEXT_PUBLIC_SYNC_STRATEGY=periodic
NEXT_PUBLIC_CONFLICT_RESOLUTION=server-wins

# Mock/测试相关
NEXT_PUBLIC_USE_MOCK_NETWORK=true
NEXT_PUBLIC_USE_MOCK_DB=true
NEXT_PUBLIC_LOAD_TEST_DATA=false
NEXT_PUBLIC_TEST_DATA_SOURCE=example

# 版本/构建信息
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_BUILD_NUMBER=1

# 日志/邮件/错误
LOG_LEVEL=INFO
# 日志适配器类型，可选值：winston | mock | default
LOGGER_PROVIDER=winston
EMAIL_PROVIDER=smtp

# R2 对象存储
R2_REGION=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# GitHub/Telegram 等第三方
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_PATH=
GITHUB_RAW_BASE=[https://raw.githubusercontent.com](https://raw.githubusercontent.com)
TG_BOT_TOKEN=
TG_CHAT_ID=