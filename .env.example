# Database Environment Configuration
NEXT_PUBLIC_DATABASE_ENV=development
NEXT_PUBLIC_DATABASE_URL=sqlite://./data/development.db

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_API_VERSION=v1

# Authentication System Configuration
NEXT_PUBLIC_AUTH_SERVICE_TYPE=better  # better, firebase
NEXT_PUBLIC_BETTER_AUTH_API_KEY=your_api_key
NEXT_PUBLIC_BETTER_AUTH_API_URL=https://api.yourdomain.com/auth

# Firebase Authentication Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-auth-domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-storage-bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Local Database Configuration
NEXT_PUBLIC_LOCAL_DB_TYPE=sqlite  # sqlite, indexeddb

# Production Cloud Database Configuration
NEXT_PUBLIC_CLOUD_DB_TYPE=supabase  # supabase, firebase, cloudflare_d1
NEXT_PUBLIC_CLOUD_DB_URL=your_db_url
NEXT_PUBLIC_CLOUD_DB_KEY=your_db_key

# Offline Storage Configuration
NEXT_PUBLIC_OFFLINE_STORAGE_TYPE=indexeddb  # capacitor-sqlite, indexeddb, localstorage, websql
NEXT_PUBLIC_OFFLINE_STORAGE_NAME=app_db
NEXT_PUBLIC_OFFLINE_STORAGE_VERSION=1

# App Configuration
NEXT_PUBLIC_APP_NAME=HeyTCM
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_ENV=development

# Log Configuration
NEXT_PUBLIC_LOG_LEVEL=debug
NEXT_PUBLIC_ENABLE_DEBUG=true

# Test Configuration
NEXT_PUBLIC_ENABLE_TEST_MODE=true
NEXT_PUBLIC_TEST_USER_ID=test-user-123

# Mock Database Configuration
NEXT_PUBLIC_MOCK_DB_TYPE=hybrid
NEXT_PUBLIC_DB_NAME=app_database_mock
NEXT_PUBLIC_MOCK_DB_JSON_PATH=./data/mock-db.json
NEXT_PUBLIC_MOCK_DB_AUTOSAVE=true
NEXT_PUBLIC_MOCK_DB_PERSISTENCE=json
NEXT_PUBLIC_USE_FAKE_INDEXEDDB=true

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Data Encryption Configuration
NEXT_PUBLIC_DB_ENCRYPTION_ENABLED=true
NEXT_PUBLIC_DB_ENCRYPTION_KEY=your-encryption-key 