# Mock环境配置 - JSON+fake IndexedDB

# 数据库环境设置
NEXT_PUBLIC_DATABASE_ENV=mock
NEXT_PUBLIC_MOCK_DB_TYPE=json
NEXT_PUBLIC_DB_NAME=app_database_mock
NEXT_PUBLIC_DB_VERSION=1

# 启用fake-indexeddb模拟客户端离线存储
NEXT_PUBLIC_USE_FAKE_INDEXEDDB=true

# JSON文件存储配置
NEXT_PUBLIC_MOCK_DB_JSON_PATH=./data/mock-db.json
NEXT_PUBLIC_MOCK_DB_AUTOSAVE=true
NEXT_PUBLIC_MOCK_DB_PERSISTENCE=json

# 离线存储配置
NEXT_PUBLIC_OFFLINE_STORAGE_TYPE=mock-indexeddb
NEXT_PUBLIC_OFFLINE_STORAGE_NAME=app_offline_db
NEXT_PUBLIC_OFFLINE_STORAGE_VERSION=1

# 数据同步配置
NEXT_PUBLIC_DB_SYNC_ENABLED=true
NEXT_PUBLIC_DB_SYNC_INTERVAL=5000

# 调试配置
NEXT_PUBLIC_DB_DEBUG=true
NEXT_PUBLIC_DB_LOG_LEVEL=debug