# Mock环境配置 - JSON+fake IndexedDB

# 数据库环境设置
NEXT_PUBLIC_DATABASE_ENV=mock
NEXT_PUBLIC_DATABASE_URL=sqlite://./data/mock.db

# API 配置
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_API_VERSION=v1

# 认证配置
NEXT_PUBLIC_AUTH_SECRET=your-mock-auth-secret
NEXT_PUBLIC_JWT_SECRET=your-mock-jwt-secret

# 应用配置
NEXT_PUBLIC_APP_NAME=HeyTCM
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_ENV=mock

# 日志配置
NEXT_PUBLIC_LOG_LEVEL=debug
NEXT_PUBLIC_ENABLE_DEBUG=true

# 测试配置
NEXT_PUBLIC_ENABLE_TEST_MODE=true
NEXT_PUBLIC_TEST_USER_ID=test-user-123

# Mock 数据库配置
NEXT_PUBLIC_MOCK_DB_TYPE=mock
NEXT_PUBLIC_DB_NAME=app_database_mock
NEXT_PUBLIC_MOCK_DB_JSON_PATH=./data/mock-db.json
NEXT_PUBLIC_MOCK_DB_AUTOSAVE=true
NEXT_PUBLIC_MOCK_DB_PERSISTENCE=json
NEXT_PUBLIC_USE_FAKE_INDEXEDDB=true

# 认证系统配置
NEXT_PUBLIC_AUTH_SERVICE_TYPE=mock  # better, firebase, mock
NEXT_PUBLIC_BETTER_AUTH_API_KEY=mock_api_key
NEXT_PUBLIC_BETTER_AUTH_API_URL=http://localhost:3001/api/auth

# Mock认证配置
NEXT_PUBLIC_MOCK_AUTH_ENABLED=true
NEXT_PUBLIC_MOCK_AUTH_USERS=test@example.com:password123,admin@example.com:admin123
NEXT_PUBLIC_MOCK_AUTH_PHONES=+8613800138000:123456,+8613900139000:654321

# Firebase 认证配置（如果使用 Firebase）
NEXT_PUBLIC_FIREBASE_API_KEY=mock_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mock-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mock-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=mock-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=987654321
NEXT_PUBLIC_FIREBASE_APP_ID=1:987654321:web:fedcba

# 离线存储配置
NEXT_PUBLIC_OFFLINE_STORAGE_TYPE=mock-indexeddb
NEXT_PUBLIC_OFFLINE_STORAGE_NAME=app_offline_db
NEXT_PUBLIC_OFFLINE_STORAGE_VERSION=1

# 数据同步配置
NEXT_PUBLIC_DB_SYNC_ENABLED=false
NEXT_PUBLIC_DB_SYNC_INTERVAL=5000

# 调试配置
NEXT_PUBLIC_DB_DEBUG=true
NEXT_PUBLIC_DB_LOG_LEVEL=debug