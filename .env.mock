NODE_ENV=development

# 认证服务
NEXT_PUBLIC_AUTH_SERVICE_TYPE=mock
NEXT_PUBLIC_DATABASE_ENV=mock
NEXT_PUBLIC_USE_MOCK_DB=true
NEXT_PUBLIC_USE_MOCK_NETWORK=true
# 在线存储环境与供应商
NEXT_PUBLIC_DATABASE_ENV=local
NEXT_PUBLIC_DATABASE_PROVIDER=mock

# 离线存储
NEXT_PUBLIC_OFFLINE_DB_TYPE=fake-indexeddb

# API
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_API_ENV=local
NEXT_PUBLIC_PLATFORM=web

# 同步/降级策略
NEXT_PUBLIC_ENABLE_OFFLINE=true
NEXT_PUBLIC_ENABLE_HYBRID=false
NEXT_PUBLIC_SYNC_ENABLED=false
NEXT_PUBLIC_USE_MOCK_DB=true
NEXT_PUBLIC_USE_MOCK_NETWORK=true
NEXT_PUBLIC_LOAD_TEST_DATA=true