# 生产环境配置
NEXT_PUBLIC_DATABASE_ENV=production
NEXT_PUBLIC_DATABASE_URL=sqlite://./data/production.db
NEXT_PUBLIC_CLOUD_DB_TYPE=supabase
NEXT_PUBLIC_DB_NAME=app_database_prod
NEXT_PUBLIC_DB_VERSION=1

# 认证系统配置
NEXT_PUBLIC_AUTH_SERVICE_TYPE=firebase  # better, firebase
NEXT_PUBLIC_BETTER_AUTH_API_KEY=prod_api_key
NEXT_PUBLIC_BETTER_AUTH_API_URL=https://api.yourdomain.com/auth

# Firebase 认证配置（如果使用 Firebase）
NEXT_PUBLIC_FIREBASE_API_KEY=prod_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-ABCDEF1234

# 数据库调试配置
NEXT_PUBLIC_DB_DEBUG=false
NEXT_PUBLIC_DB_LOG_LEVEL=error

# 性能监控配置
NEXT_PUBLIC_DB_PERFORMANCE_MONITOR=true
NEXT_PUBLIC_DB_QUERY_TIMEOUT=2000

# 数据同步配置
NEXT_PUBLIC_DB_SYNC_ENABLED=true
NEXT_PUBLIC_DB_SYNC_INTERVAL=300000  # 5分钟
NEXT_PUBLIC_DB_SYNC_BATCH_SIZE=100

# 离线存储配置
NEXT_PUBLIC_OFFLINE_STORAGE_TYPE=indexeddb
NEXT_PUBLIC_OFFLINE_STORAGE_NAME=app_offline_prod
NEXT_PUBLIC_OFFLINE_STORAGE_VERSION=1

# 云端数据库配置
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 数据加密配置
NEXT_PUBLIC_DB_ENCRYPTION_ENABLED=true
NEXT_PUBLIC_DB_ENCRYPTION_KEY=your_encryption_key

# API 配置
NEXT_PUBLIC_API_URL=https://api.heytcm.com/api
NEXT_PUBLIC_API_VERSION=v1

# 认证配置
NEXT_PUBLIC_AUTH_SECRET=your-production-auth-secret
NEXT_PUBLIC_JWT_SECRET=your-production-jwt-secret

# 应用配置
NEXT_PUBLIC_APP_NAME=HeyTCM
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_ENV=production

# 日志配置
NEXT_PUBLIC_LOG_LEVEL=info
NEXT_PUBLIC_ENABLE_DEBUG=false

# 测试配置
NEXT_PUBLIC_ENABLE_TEST_MODE=false 