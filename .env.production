# 生产环境配置
NODE_ENV=production
AUTH_TYPE=firebase

# Firebase（生产环境需填写真实值）
NEXT_PUBLIC_FIREBASE_API_KEY=your-prod-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-prod-auth-domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-prod-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=your-prod-app-id

# API
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_API_ENV=prod
NEXT_PUBLIC_PLATFORM=web

# 数据库/同步/降级策略
ENABLE_OFFLINE=false
ENABLE_HYBRID=false
ONLINE_STORAGE_TYPE=firebase
OFFLINE_STORAGE_TYPE=indexeddb
SYNC_ENABLED=true
SYNC_STRATEGY=periodic
CONFLICT_RESOLUTION=server-wins

# Mock/测试
USE_MOCK_NETWORK=false
USE_MOCK_DB=false
LOAD_TEST_DATA=false
TEST_DATA_SOURCE=example

# 版本/构建信息
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_BUILD_NUMBER=prod

# 其它
CDN_BASE_URL=https://cdn.yourdomain.com
NEXT_PUBLIC_FEATURE_FLAG_NEW_CHAT=false
