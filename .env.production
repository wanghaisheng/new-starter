NODE_ENV=production

# 认证服务
NEXT_PUBLIC_AUTH_SERVICE_TYPE=firebase

# 在线存储环境与供应商
NEXT_PUBLIC_DATABASE_ENV=production
NEXT_PUBLIC_DATABASE_PROVIDER=firebase

# 离线存储
NEXT_PUBLIC_OFFLINE_DB_TYPE=indexeddb   # 或 sqlite（移动端）

# API
NEXT_PUBLIC_API_URL=[https://your-prod-api.com](https://your-prod-api.com)
NEXT_PUBLIC_API_ENV=production
NEXT_PUBLIC_PLATFORM=web

# 同步/降级策略
NEXT_PUBLIC_ENABLE_OFFLINE=true
NEXT_PUBLIC_ENABLE_HYBRID=false
NEXT_PUBLIC_SYNC_ENABLED=true
NEXT_PUBLIC_USE_MOCK_DB=false
NEXT_PUBLIC_USE_MOCK_NETWORK=false
NEXT_PUBLIC_LOAD_TEST_DATA=false

# Firebase 配置
NEXT_PUBLIC_FIREBASE_API_KEY=xxx
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=xxx
NEXT_PUBLIC_FIREBASE_PROJECT_ID=xxx
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=xxx
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=xxx
NEXT_PUBLIC_FIREBASE_APP_ID=xxx