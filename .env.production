# 生产环境配置
NEXT_PUBLIC_DATABASE_ENV=production
NEXT_PUBLIC_CLOUD_DB_TYPE=supabase
NEXT_PUBLIC_DB_NAME=app_database_prod
NEXT_PUBLIC_DB_VERSION=1

# 数据库调试配置
NEXT_PUBLIC_DB_DEBUG=false
NEXT_PUBLIC_DB_LOG_LEVEL=error

# 性能监控配置
NEXT_PUBLIC_DB_PERFORMANCE_MONITOR=true
NEXT_PUBLIC_DB_QUERY_TIMEOUT=2000

# 数据同步配置
NEXT_PUBLIC_DB_SYNC_ENABLED=true
NEXT_PUBLIC_DB_SYNC_INTERVAL=300000  # 5分钟
NEXT_PUBLIC_DB_SYNC_BATCH_SIZE=100

# 离线存储配置
NEXT_PUBLIC_OFFLINE_STORAGE_TYPE=indexeddb
NEXT_PUBLIC_OFFLINE_STORAGE_NAME=app_offline_prod
NEXT_PUBLIC_OFFLINE_STORAGE_VERSION=1

# 云端数据库配置
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 数据加密配置
NEXT_PUBLIC_DB_ENCRYPTION_ENABLED=true
NEXT_PUBLIC_DB_ENCRYPTION_KEY=your_encryption_key 