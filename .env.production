# 生产环境配置
NEXT_PUBLIC_DATABASE_ENV=production
NEXT_PUBLIC_CLOUD_DB_TYPE=supabase
NEXT_PUBLIC_CLOUD_DB_URL=your_db_url
NEXT_PUBLIC_CLOUD_DB_KEY=your_db_key

# 离线存储配置（生产环境根据平台自动选择）
NEXT_PUBLIC_OFFLINE_STORAGE_TYPE=capacitor-sqlite  # 移动端使用Capacitor SQLite，Web端使用IndexedDB
NEXT_PUBLIC_OFFLINE_STORAGE_NAME=app_db_prod
NEXT_PUBLIC_OFFLINE_STORAGE_VERSION=1 