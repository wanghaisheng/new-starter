{
  "name": "capacitor-nextjs-ionic-tailwind",
  "version": "1.0.0",
  "description": "Next.js 15 + Ionic + Tailwind + Capacitor 全栈启动项目",
  "scripts": {
    "dev": "next dev",
    "dev:mock": "cross-env NEXT_PUBLIC_DATABASE_ENV=mock next dev",
    "dev:local": "cross-env NEXT_PUBLIC_DATABASE_ENV=local next dev",
    "dev:prod": "cross-env NEXT_PUBLIC_DATABASE_ENV=production next dev",
    "mock": "node run-mock-env.js",
    "mock:debug": "cross-env NEXT_PUBLIC_DB_DEBUG=true NEXT_PUBLIC_DB_LOG_LEVEL=debug node run-mock-env.js",
    "verify:schema": "node tools/verify-schema.js",
    "build": "next build",
    "build:static": "next build && next start",
    "build:capacitor": "next build && mkdir -p dist && cp -r .next/standalone/* dist/ && cp -r .next/static dist/",
    "build:android": "bun run build:capacitor && bunx cap sync android && bunx cap open android",
    "build:ios": "bun run build:capacitor && bunx cap sync ios && bunx cap open ios",
    "start": "next start",
    "copy:sql:wasm": "copyfiles -u 3 node_modules/sql.js/dist/sql-wasm.wasm app/assets",
    "lint": "next lint",
    "lint:imports": "node tools/check-import-paths.js",
    "lint:imports:fix": "node tools/check-import-paths.js --fix",
    "cap:sync": "bunx cap sync",
    "cap:android": "bunx cap open android",
    "cap:ios": "bunx cap open ios",
    "deploy:test": "echo '部署到测试环境'",
    "deploy:prod": "echo '部署到生产环境'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci",
    "test:coverage": "jest --coverage",
    "test:offline": "jest --config=jest.offline.config.js",
    "test:offline:watch": "jest --config=jest.offline.config.js --watch",
    "test:offline:coverage": "jest --config=jest.offline.config.js --coverage",
    "test:all": "node scripts/run-tests.js --all",
    "test:all:report": "node scripts/run-tests.js --all --report",
    "test:all:coverage": "node scripts/run-tests.js --all --coverage",
    "generate:offline-test": "node scripts/generate-offline-test.js",
    "check:env": "bash docs/tasks/tools/check-environment.sh",
    "check:env:force": "bash docs/tasks/tools/check-environment.sh --force",
    "init:project": "bash docs/tasks/tools/init-project.sh",
    "init:git": "bash docs/tasks/tools/init-git-repo.sh",
    "install:deps": "bash docs/tasks/tools/install-dependencies.sh",
    "commit:code": "bash docs/tasks/tools/commit-code.sh",
    "auth:generate": "npx @better-auth/cli generate",
    "auth:migrate": "npx @better-auth/cli migrate"
  },
  "dependencies": {
    "@better-auth/client": "^0.0.2-alpha.3",
    "@capacitor-community/sqlite": "^7.0.0",
    "@capacitor/android": "^5.7.0",
    "@capacitor/camera": "7.0.0",
    "@capacitor/core": "^7.2.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/geolocation": "^7.1.1",
    "@capacitor/ios": "^5.7.0",
    "@capacitor/network": "^7.0.0",
    "@capacitor/storage": "^1.2.5",
    "@genkit-ai/googleai": "^1.4.0",
    "@genkit-ai/vertexai": "^1.4.0",
    "@ionic/pwa-elements": "^3.3.0",
    "@ionic/react": "^7.8.0",
    "@stencil/core": "^4.28.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/firebase": "^3.2.3",
    "@types/winston": "^2.4.4",
    "better-sqlite3": "^11.9.1",
    "clsx": "^2.1.1",
    "copyfiles": "^2.4.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.41.0",
    "fake-indexeddb": "^6.0.0",
    "firebase": "^11.6.0",
    "framer-motion": "^12.6.2",
    "idb": "^8.0.2",
    "jeep-sqlite": "^2.8.0",
    "next": "^15.0.0",
    "next-intl": "^4.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sql.js": "^1.13.0",
    "tailwind-merge": "^3.1.0",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.21",
    "winston": "^3.17.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.1.0",
    "@faker-js/faker": "^9.6.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/lru-cache": "^7.10.10",
    "@types/node": "^20.17.28",
    "@types/react": "^18.2.0",
    "@types/sql.js": "^1.4.9",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@vitest/coverage-v8": "^3.0.9",
    "autoprefixer": "^10.4.16",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.30.6",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-no-relative-import-paths": "^1.5.3",
    "jest": "^29.7.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.3.0",
    "typescript": "^5.3.3",
    "vitest": "^3.0.9"
  }
}
