    "@types/pg": "^8.11.11",
    "@types/winston": "^2.4.4",
    "better-auth": "^0.0.2-alpha.3",
    "better-sqlite3": "^11.9.1",
    "clsx": "^2.1.1",
    "copyfiles": "^2.4.1",
    "date-fns": "^4.1.0",
    "dgram": "^1.0.1",
    "dns": "^0.2.2",
    "drizzle-orm": "^0.41.0",
    "fake-indexeddb": "^6.0.0",
    "firebase": "^11.6.0",
    "framer-motion": "^12.6.2",
    "idb": "^8.0.2",
    "jeep-sqlite": "^2.8.0",
    "kysely": "^0.27.6",
    "mysql2": "^3.14.0",
    "next": "^15.0.0",
    "next-intl": "^4.0.2",
    "pg": "^8.14.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sql.js": "^1.13.0",
    "tailwind-merge": "^3.1.0",
    "ts-error": "^1.0.6",
    "ts-morph": "^25.0.1",
