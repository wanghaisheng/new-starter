{
  "name": "capacitor-nextjs-ionic-tailwind",
  "version": "1.0.0",
  "description": "Next.js 15 + Ionic + Tailwind + Capacitor 全栈启动项目",
  "scripts": {
    "dev": "bun run --bun next dev",
    "dev:mock": "bun run --bun --env-file=.env.mock next dev",
    "dev:dev": "bun run --bun --env-file=.env.dev next dev",
    "dev:prod": "bun run --bun --env-file=.env.prod next dev",
    "mock": "bun run --bun scripts/load-demo-data.js && bun run --bun --env-file=.env.mock ./run-mock-env.js",
    "mock:debug": "NODE_OPTIONS='--max-old-space-size=4096' bun run --bun scripts/load-demo-data.js && bun run --bun --env-file=.env.mock --env-file=.env.debug ./run-mock-env.js",
    "build": "bun run --bun next build",
    "build:mock": "NODE_OPTIONS='--max-old-space-size=4096' bun run --bun --env-file=.env.mock next build",
    "build:dev": "bun run --bun --env-file=.env.dev next build",
    "build:prod": "bun run --bun --env-file=.env.prod next build",
    "build:static": "bun run --bun next build && bun run --bun next start",
    "build:capacitor": "bun run --bun next build && mkdir -p dist && cp -r .next/standalone/* dist/ && cp -r .next/static dist/",
    "build:android": "bun run --bun build:capacitor && bunx cap sync android && bunx cap open android",
    "build:ios": "bun run --bun build:capacitor && bunx cap sync ios && bunx cap open ios",
    "start": "bun run --bun next start",
    "start:mock": "NODE_OPTIONS='--max-old-space-size=4096' bun run --bun --env-file=.env.mock next start",
    "start:dev": "bun run --bun --env-file=.env.dev next start",
    "start:prod": "bun run --bun --env-file=.env.prod next start",
    "copy:sql:wasm": "bun run --bun copyfiles -u 3 node_modules/sql.js/dist/sql-wasm.wasm app/assets",
    "lint": "bun run --bun next lint",
    "lint:imports": "bun run --bun tools/check-import-paths.js",
    "lint:imports:fix": "bun run --bun tools/check-import-paths.js --fix",
    "cap:sync": "bunx cap sync",
    "cap:android": "bunx cap open android",
    "cap:ios": "bunx cap open ios",
    "deploy:dev": "echo '部署到开发环境'",
    "deploy:prod": "echo '部署到生产环境'",
    "test": "bun run --bun jest",
    "test:mock": "NODE_OPTIONS='--max-old-space-size=4096' bun run --bun --env-file=.env.mock jest",
    "test:dev": "bun run --bun --env-file=.env.dev jest",
    "test:prod": "bun run --bun --env-file=.env.prod jest",
    "test:watch": "bun run --bun jest --watch",
    "test:ci": "bun run --bun jest --ci",
    "test:coverage": "bun run --bun jest --coverage",
    "test:offline": "bun run --bun jest --config=jest.offline.config.js",
    "test:offline:watch": "bun run --bun jest --config=jest.offline.config.js --watch",
    "test:offline:coverage": "bun run --bun jest --config=jest.offline.config.js --coverage",
    "test:all": "bun run --bun scripts/run-tests.js --all",
    "test:all:report": "bun run --bun scripts/run-tests.js --all --report",
    "test:all:coverage": "bun run --bun scripts/run-tests.js --all --coverage",
    "generate:offline-test": "bun run --bun scripts/generate-offline-test.js",
    "check:env": "bun run --bun docs/tasks/tools/check-environment.sh",
    "check:env:force": "bun run --bun docs/tasks/tools/check-environment.sh --force",
    "check:env:mock": "NODE_OPTIONS='--max-old-space-size=4096' bun run --bun --env-file=.env.mock docs/tasks/tools/check-environment.sh",
    "check:env:dev": "bun run --bun --env-file=.env.dev docs/tasks/tools/check-environment.sh",
    "check:env:prod": "bun run --bun --env-file=.env.prod docs/tasks/tools/check-environment.sh",
    "init:project": "bun run --bun docs/tasks/tools/init-project.sh",
    "init:git": "bun run --bun docs/tasks/tools/init-git-repo.sh",
    "install:deps": "bun run --bun docs/tasks/tools/install-dependencies.sh",
    "commit:code": "bun run --bun docs/tasks/tools/commit-code.sh",
    "auth:generate": "bunx @better-auth/cli generate",
    "auth:migrate": "bunx @better-auth/cli migrate",
    "demo:load": "bun run --bun src/core/lib/db/clients/mock/load-demo-data.ts",
    "demo:load:example": "bun run --bun src/core/lib/db/clients/mock/load-demo-data.ts example",
    "demo:load:dating": "bun run --bun src/core/lib/db/clients/mock/load-demo-data.ts dating"
  },
  "dependencies": {
    "@better-auth/client": "^0.0.2-alpha.3",
    "@capacitor-community/sqlite": "^7.0.0",
    "@capacitor/android": "^5.7.0",
    "@capacitor/camera": "7.0.0",
    "@capacitor/core": "^7.2.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/geolocation": "^7.1.1",
    "@capacitor/ios": "^5.7.0",
    "@capacitor/network": "^7.0.0",
    "@capacitor/storage": "^1.2.5",
    "@genkit-ai/googleai": "^1.4.0",
    "@genkit-ai/vertexai": "^1.4.0",
    "@ionic/pwa-elements": "^3.3.0",
    "@ionic/react": "^7.8.0",
    "@libsql/client": "^0.15.2",
    "@stencil/core": "^4.28.2",
    "@supabase/supabase-js": "^2.49.4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/firebase": "^3.2.3",
    "@types/pg": "^8.11.11",
    "@types/winston": "^2.4.4",
    "better-sqlite3": "^11.9.1",
    "clsx": "^2.1.1",
    "copyfiles": "^2.4.1",
    "date-fns": "^4.1.0",
    "dgram": "^1.0.1",
    "dns": "^0.2.2",
    "drizzle-orm": "^0.41.0",
    "fake-indexeddb": "^6.0.0",
    "firebase": "^11.6.0",
    "framer-motion": "^12.6.2",
    "idb": "^8.0.2",
    "jeep-sqlite": "^2.8.0",
    "kysely": "^0.27.6",
    "mysql2": "^3.14.0",
    "next": "^15.0.0",
    "next-intl": "^4.0.2",
    "pg": "^8.14.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sql.js": "^1.13.0",
    "tailwind-merge": "^3.1.0",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.21",
    "winston": "^3.17.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.1.0",
    "@faker-js/faker": "^9.6.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/lru-cache": "^7.10.10",
    "@types/node": "^20.17.28",
    "@types/react": "^18.2.0",
    "@types/sql.js": "^1.4.9",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@vitest/coverage-v8": "^3.0.9",
    "autoprefixer": "^10.4.16",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.30.6",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-no-relative-import-paths": "^1.5.3",
    "jest": "^29.7.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.3.0",
    "typescript": "^5.3.3",
    "vitest": "^3.0.9"
  }
}
