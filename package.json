{
  "name": "capacitor-nextjs-ionic-tailwind",
  "version": "1.0.0",
  "description": "Next.js 15 + Ionic + Tailwind + Capacitor 全栈启动项目",
  "scripts": {
    "dev": "next dev",
    "dev:mock": "cross-env NEXT_PUBLIC_DATABASE_ENV=mock next dev",
    "dev:local": "cross-env NEXT_PUBLIC_DATABASE_ENV=local next dev",
    "dev:prod": "cross-env NEXT_PUBLIC_DATABASE_ENV=production next dev",
    "build": "next build",
    "build:static": "next build",
    "start": "next start",
    "copy:sql:wasm": "copyfiles -u 3 node_modules/sql.js/dist/sql-wasm.wasm app/assets",
    "lint": "next lint",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "deploy:test": "echo '部署到测试环境'",
    "deploy:prod": "echo '部署到生产环境'",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.0",
    "@capacitor/android": "^5.7.0",
    "@capacitor/camera": "7.0.0",
    "@capacitor/core": "^7.1.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/ios": "^5.7.0",
    "@capacitor/network": "^7.0.0",
    "@capacitor/storage": "^1.2.5",
    "@genkit-ai/googleai": "^1.4.0",
    "@genkit-ai/vertexai": "^1.4.0",
    "@ionic/pwa-elements": "^3.3.0",
    "@ionic/react": "^7.8.0",
    "@stencil/core": "^4.28.2",
    "@types/better-sqlite3": "^7.6.12",
    "better-sqlite3": "^11.9.1",
    "copyfiles": "^2.4.1",
    "drizzle-orm": "^0.41.0",
    "fake-indexeddb": "^6.0.0",
    "firebase": "^11.5.0",
    "framer-motion": "^12.6.2",
    "idb": "^8.0.2",
    "jeep-sqlite": "^2.8.0",
    "next": "^15.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sql.js": "^1.13.0",
    "typeorm": "^0.3.21"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/jest": "^29.5.14",
    "@types/lru-cache": "^7.10.10",
    "@types/node": "^20.17.28",
    "@types/react": "^18.2.0",
    "@types/sql.js": "^1.4.9",
    "autoprefixer": "^10.4.16",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.30.6",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.0.0",
    "jest": "^29.7.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.3.0",
    "typescript": "^5.3.3",
    "vitest": "^3.0.9"
  }
}
