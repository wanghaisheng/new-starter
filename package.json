{
  "name": "capacitor-nextjs-ionic-tailwind",
  "version": "1.0.0",
  "description": "Next.js 15 + Ionic + Tailwind + Capacitor 全栈启动项目",
  "scripts": {
    "dev": "set NODE_OPTIONS=--max-old-space-size=4096 && node run-env.js .env.development && next dev",
    "dev:mock": "set NODE_OPTIONS=--max-old-space-size=4096 && node run-env.js .env.mock && next dev",
    "dev:prod": "set NODE_OPTIONS=--max-old-space-size=4096 && node run-env.js .env.production && next dev",
    "build": "set NODE_OPTIONS=--max-old-space-size=4096 && node run-env.js .env.development && next build",
    "build:mock": "set NODE_OPTIONS=--max-old-space-size=4096 && node run-env.js .env.mock && next build",
    "build:prod": "set NODE_OPTIONS=--max-old-space-size=4096 && node run-env.js .env.production && next build",
    "start": "set NODE_OPTIONS=--max-old-space-size=4096 && node run-env.js .env.development && next start",
    "start:mock": "set NODE_OPTIONS=--max-old-space-size=4096 && node run-env.js .env.mock && next start",
    "start:prod": "set NODE_OPTIONS=--max-old-space-size=4096 && node run-env.js .env.production && next start",
    "test": "set NODE_OPTIONS=--max-old-space-size=4096 && node run-env.js .env.development && jest",
    "test:mock": "set NODE_OPTIONS=--max-old-space-size=4096 && node run-env.js .env.mock && jest",
    "test:prod": "set NODE_OPTIONS=--max-old-space-size=4096 && node run-env.js .env.production && jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci",
    "test:coverage": "jest --coverage",
    "test:offline": "jest --config=jest.offline.config.js",
    "test:offline:watch": "jest --config=jest.offline.config.js --watch",
    "test:offline:coverage": "jest --config=jest.offline.config.js --coverage",
    "test:all": "node scripts/run-tests.js --all",
    "test:all:report": "node scripts/run-tests.js --all --report",
    "test:all:coverage": "node scripts/run-tests.js --all --coverage",
    "generate:offline-test": "node scripts/generate-offline-test.js",
    "check:env": "sh docs/tasks/tools/check-environment.sh",
    "check:env:force": "sh docs/tasks/tools/check-environment.sh --force",
    "check:env:mock": "set NODE_OPTIONS=--max-old-space-size=4096 && sh docs/tasks/tools/check-environment.sh --env-file=.env.mock",
    "check:env:dev": "sh docs/tasks/tools/check-environment.sh --env-file=.env.development",
    "check:env:prod": "sh docs/tasks/tools/check-environment.sh --env-file=.env.production",
    "init:project": "sh docs/tasks/tools/init-project.sh",
    "init:git": "sh docs/tasks/tools/init-git-repo.sh",
    "install:deps": "sh docs/tasks/tools/install-dependencies.sh",
    "commit:code": "sh docs/tasks/tools/commit-code.sh",
    "auth:generate": "pnpx @better-auth/cli generate",
    "auth:migrate": "pnpx @better-auth/cli migrate",
    "demo:load": "node src/core/lib/db/clients/mock/load-demo-data.ts",
    "demo:load:example": "node src/core/lib/db/clients/mock/load-demo-data.ts example",
    "demo:load:dating": "node src/core/lib/db/clients/mock/load-demo-data.ts dating",
    "copy:sql:wasm": "copyfiles -u 3 node_modules/sql.js/dist/sql-wasm.wasm app/assets",
    "lint": "next lint",
    "lint:imports": "node tools/check-import-paths.js",
    "lint:imports:fix": "node tools/check-import-paths.js --fix",
    "cap:sync": "pnpx cap sync",
    "cap:android": "pnpx cap open android",
    "cap:ios": "pnpx cap open ios",
    "deploy:dev": "echo '部署到开发环境'",
    "deploy:prod": "echo '部署到生产环境'",
    "gen:repository-map": "tsx scripts/gen-repository-map.ts",
    "gen:schema-from-types": "tsx scripts/gen-schema-from-types.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "@better-auth/client": "^0.0.2-alpha.3",
    "@capacitor-community/sqlite": "^7.0.0",
    "@capacitor/action-sheet": "^7.0.1",
    "@capacitor/android": "^5.7.0",
    "@capacitor/app": "^7.0.1",
