        </IonToolbar>
      </IonHeader>
      <IonContent className="ion-padding" data-testid="privacy-policy-content">
        {!isOnline && (
          <div className={styles.offlineMessage} data-testid="offline-message">
            {t('common.offlineMessage')}
          </div>
        )}
