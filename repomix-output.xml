 * POST /api/mobile/v1/demo/load?source=example
 * 
 * 参数:
 * - source: 数据源，可选值为 'example' 或 'dating'，默认为 'example'
 * 
 * 返回:
 * - 成功: { success: true, message: '演示数据加载成功', stats: { users: 2, matches: 1, messages: 3 } }
 * - 失败: { success: false, error: '错误信息' }
 */
