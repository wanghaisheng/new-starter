        updatedAt: { type: 'date' }
      },
      indexes: {
        email_idx: { columns: ['email'], unique: true }
      }
    },
    matches: {
      columns: {
        id: { type: 'string', constraints: ['primary key'] },
        users: { type: 'array' },
        createdAt: { type: 'date' },
        updatedAt: { type: 'date' }
      }
    },
    messages: {
      columns: {
        id: { type: 'string', constraints: ['primary key'] },
        matchId: { type: 'string' },
        senderId: { type: 'string' },
        content: { type: 'string' },
        createdAt: { type: 'date' },
        updatedAt: { type: 'date' }
      },
      indexes: {
        match_idx: { columns: ['matchId'] }
      }
    }
  }
};

// 环境特定配置
const environments: Record<string, DatabaseConfigType> = {
  development: {
    ...baseConfig as DatabaseConfigType,
    engine: 'mock',
    name: 'app_database_dev',
    version: 1,
    sync: {
      enabled: true,
      strategy: 'periodic',
      conflictResolution: 'server-wins',
      syncIntervalMs: 5000
