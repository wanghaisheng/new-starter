            </IonItemDivider>
            
            {loginHistory.map(item => (
              <IonItem key={item.id}>
                <IonIcon icon={timeOutline} slot="start" />
                <IonLabel>
                  <h2>{item.device}</h2>
                  <p>{item.location}</p>
                  <p className="text-xs text-gray-400">{item.date}</p>
                </IonLabel>
                {item.current && (
                  <IonBadge color="success" slot="end">
