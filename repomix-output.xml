  it('应能处理富媒体消息', async () => {
    enhancer.beforeSend = vi.fn(async d => ({ ...d, mediaUrl: 'http://media' }));
    service = new MessageService(
      configService,
      { text: textRepository },
      { ai: () => enhancer }
