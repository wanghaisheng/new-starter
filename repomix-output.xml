    onMessageChangeMock = undefined;
  });
  function MockProvider({ children }: { children: React.ReactNode }) {
    (global as any).eventManager = {
      on: vi.fn(),
      off: vi.fn(),
      emit: vi.fn(),
    };
    return <>{children}</>;
  }

  it('正常流程：能获取消息并响应订阅', async () => {
