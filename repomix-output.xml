          {historyLoading ? '加载中...' : '刷新支付历史'}
        </IonButton>
        {historyError && <div className="text-red-500 text-center text-xs mb-2">{historyError.message}</div>}
        {historyLoading ? (
          <div className="flex justify-center my-6"><IonSpinner name="crescent" /></div>
