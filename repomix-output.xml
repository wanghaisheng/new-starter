      case 'localstorage':
        return new LocalStorageDataInitializerAdapter();
      case 'indexeddb':
        // 未来可以实现IndexedDB适配器
        console.log('[ClientDataInitializerAdapterFactory] IndexedDB适配器尚未实现，使用LocalStorage适配器代替');
