import { useState, useEffect, useCallback, useRef } from 'react';
import { MessageServiceRegistry } from '@/core/services/business/messages/registry/message-service-registry';
import type { Message } from '@/core/lib/db/types/message';
import type { CreateMessageData, UpdateMessageData } from '@/core/lib/db/types/message';
import type { IMessageService } from '@/core/services/business/messages/types/message-service';
import { useToast } from './useToast';

export function useMessages(conversationId: string) {
  const [messages, setMessages] = useState<Message[]>([]);
  const [loading, setLoading] = useState(true);
  const [fetchError, setFetchError] = useState<Error | null>(null);
  const [sendError, setSendError] = useState<Error | null>(null);
  const [updateError, setUpdateError] = useState<Error | null>(null);
  const [deleteError, setDeleteError] = useState<Error | null>(null);
  const [empty, setEmpty] = useState(false);
  const { triggerToast } = useToast();
  const serviceRef = useRef<IMessageService | null>(null);
  const pageRef = useRef<number>(1);
  const pageSizeRef = useRef<number>(20);

  useEffect(() => {
    const type = process.env.NEXT_PUBLIC_MESSAGE_SERVICE_TYPE || (process.env.NODE_ENV === 'development' ? 'mock' : 'remote');
    const provider = MessageServiceRegistry.getInstance().getProvider(type);
    serviceRef.current = provider ? provider() : null;
  }, []);

  useEffect(() => {
    // eslint-disable-next-line no-console
    console.log('[useMessages effect] deps:', { conversationId, messages, empty, loading, fetchError });
    // ====== DEBUG: 检查 conversationId, 注册订阅 ======
    if (!conversationId) {
      // eslint-disable-next-line no-console
      console.log('[useMessages effect] conversationId is falsy, skip subscribe');
      return;
    }
    const unsub = serviceRef.current?.onMessageChange((msgs: Message[]) => {
      setMessages(msgs);
      setEmpty(msgs.length === 0);
    });
    return () => unsub && unsub();
  }, [conversationId, messages, empty, loading, fetchError]);

  useEffect(() => {
    // eslint-disable-next-line no-console
    console.log('[useMessages effect] deps:', { conversationId, messages, empty, loading, fetchError });
  }, [conversationId, messages, empty, loading, fetchError]);

  const fetchMessages = useCallback(async (page = 1, pageSize = 20) => {
    if (!conversationId) return;
    setLoading(true);
    setFetchError(null);
    try {
      if (!serviceRef.current) throw new Error('服务未初始化');
      const data = await serviceRef.current.getMessagesByPage(conversationId, page, pageSize);
      setMessages(data);
      setEmpty(data.length === 0);
    } catch (err) {
      const error = err instanceof Error ? err : new Error('获取消息失败');
      setFetchError(error);
      setEmpty(true);
      triggerToast(error.message);
    } finally {
      setLoading(false);
    }
  }, [conversationId, triggerToast]);

  const sendMessage = useCallback(async (data: CreateMessageData) => {
    setLoading(true);
    setSendError(null);
    try {
      if (!serviceRef.current) throw new Error('服务未初始化');
      const msg = await serviceRef.current.sendMessage(data);
      triggerToast('消息已发送');
      return msg;
    } catch (err) {
      const error = err instanceof Error ? err : new Error('发送消息失败');
      setSendError(error);
      triggerToast(error.message);
      throw error;
    } finally {
      setLoading(false);
    }
  }, [triggerToast]);

  const sendRichMessage = useCallback(async (data: { matchId: string; senderId: string; receiverId: string; content: string; type: 'text' | 'image'; mediaUrl?: string }) => {
    setLoading(true);
    setSendError(null);
    try {
      if (!serviceRef.current) throw new Error('服务未初始化');
      const msg = await serviceRef.current.sendRichMessage(data);
      triggerToast('富媒体消息已发送');
      return msg;
    } catch (err) {
      const error = err instanceof Error ? err : new Error('发送富媒体消息失败');
      setSendError(error);
      triggerToast(error.message);
      throw error;
    } finally {
      setLoading(false);
    }
  }, [triggerToast]);

  const updateMessage = useCallback(async (id: string, data: UpdateMessageData) => {
    setLoading(true);
    setUpdateError(null);
    try {
      if (!serviceRef.current) throw new Error('服务未初始化');
      const msg = await serviceRef.current.updateMessage(id, data);
      triggerToast('消息已更新');
      return msg;
    } catch (err) {
      const error = err instanceof Error ? err : new Error('更新消息失败');
      setUpdateError(error);
      triggerToast(error.message);
      throw error;
    } finally {
      setLoading(false);
    }
  }, [triggerToast]);

  const deleteMessage = useCallback(async (id: string) => {
    setLoading(true);
    setDeleteError(null);
    try {
      if (!serviceRef.current) throw new Error('服务未初始化');
      await serviceRef.current.deleteMessage(id);
      triggerToast('消息已删除');
    } catch (err) {
      const error = err instanceof Error ? err : new Error('删除消息失败');
      setDeleteError(error);
      triggerToast(error.message);
      throw error;
    } finally {
      setLoading(false);
    }
  }, [triggerToast]);

  const markAsRead = useCallback(async (id: string) => {
    setLoading(true);
    setUpdateError(null);
    try {
      if (!serviceRef.current) throw new Error('服务未初始化');
      await serviceRef.current.markAsRead(id);
      triggerToast('消息已标记为已读');
    } catch (err) {
      const error = err instanceof Error ? err : new Error('标记消息为已读失败');
      setUpdateError(error);
      triggerToast(error.message);
      throw error;
    } finally {
      setLoading(false);
    }
  }, [triggerToast]);

  const fetchMore = useCallback(async (page = 1, pageSize = 20) => {
    await fetchMessages(page, pageSize);
  }, [fetchMessages]);

  const getUserMessages = useCallback(async (userId: string) => {
    setLoading(true);
    setFetchError(null);
    try {
      if (!serviceRef.current) throw new Error('服务未初始化');
      const data = await serviceRef.current.getUserMessages(userId);
      setMessages(data);
      setEmpty(data.length === 0);
      return data;
    } catch (err) {
      const error = err instanceof Error ? err : new Error('获取用户消息失败');
      setFetchError(error);
      setEmpty(true);
      triggerToast(error.message);
      throw error;
    } finally {
      setLoading(false);
    }
  }, [triggerToast]);

  const getConversationMessages = useCallback(async (conversationId: string) => {
    setLoading(true);
    setFetchError(null);
    try {
      if (!serviceRef.current) throw new Error('服务未初始化');
      const data = await serviceRef.current.getConversationMessages(conversationId);
      setMessages(data);
      setEmpty(data.length === 0);
      return data;
    } catch (err) {
      const error = err instanceof Error ? err : new Error('获取会话消息失败');
      setFetchError(error);
      setEmpty(true);
      triggerToast(error.message);
      throw error;
    } finally {
      setLoading(false);
    }
  }, [triggerToast]);

  return {
    messages,
    loading,
    fetchError,
    sendError,
    updateError,
    deleteError,
    empty,
    fetchMessages,
    sendMessage,
    sendRichMessage,
    updateMessage,
    deleteMessage,
    markAsRead,
    fetchMore,
    getUserMessages,
    getConversationMessages,
  };
}
</file>

