import { useState, useEffect, useCallback } from 'react';
import { AuthServiceFactory } from '@/core/services/business/auth/factory/auth-service-factory';
import { AuthEventManager, AuthEventData } from '@/core/services/business/auth/factory/auth-events';
import { useAuthStore } from '@/core/store/auth-store';
import type { IAuthService, AuthUser, AuthResult } from '@/core/services/business/auth/types/auth-service';
import { useToast } from './useToast';

/**
 * 认证状态
 */
export interface AuthState {
  user: AuthUser | null;
  isAuthenticated: boolean;
  isLoading: boolean;
  error: Error | null;
  enabledMethods: string[];
  empty: boolean;
}

/**
 * 认证 Hook
 * 提供认证状态、认证方法与统一异常提示
 */
export function useAuth() {
  const [isLoading, setIsLoading] = useState(true);
  const [error, setError] = useState<Error | null>(null);
  const [authProvider, setAuthProvider] = useState<IAuthService | null>(null);
  const [enabledMethods, setEnabledMethods] = useState<string[]>([]);
  const [empty, setEmpty] = useState(false);
  const { triggerToast } = useToast();
  // 使用 auth-store
  const { user, token, setUser, setToken, clearAuth } = useAuthStore();
  const eventManager = AuthEventManager.getInstance();

  // 初始化认证提供者
  useEffect(() => {
    const initProvider = async () => {
      try {
        const rawType = process.env.NEXT_PUBLIC_AUTH_SERVICE_TYPE;
        let type: 'mock'|'firebase'|'better'|'hybrid' = 'mock';
        if (rawType === 'firebase' || rawType === 'better' || rawType === 'hybrid') {
          type = rawType;
        } else {
          type = 'mock';
        }
        // 工厂/适配器模式，便于 mock/remote 切换
        const provider = AuthServiceFactory.createService(type);
        setAuthProvider(provider);
        // 获取支持的认证方式
        if (provider && typeof provider.getEnabledMethods === 'function') {
          const methods = await provider.getEnabledMethods();
          setEnabledMethods(Array.isArray(methods) ? methods : []);
        } else {
          setEnabledMethods([]);
        }
      } catch (error) {
        setError(error as Error);
        setIsLoading(false);
        setEmpty(true);
        setEnabledMethods([]);
        triggerToast((error as Error).message || '认证服务初始化失败');
      }
    };
    initProvider();
  }, [triggerToast]);

  // 更新认证状态
  const updateAuthState = useCallback(async () => {
    if (!authProvider) {
      setEmpty(true);
      return;
    }
    try {
      setIsLoading(true);
      const currentUser = await authProvider.getCurrentUser();
      if (currentUser) {
        setUser(currentUser);
        setEmpty(false);
      } else {
        setEmpty(true);
      }
    } catch (error) {
      setError(error as Error);
      setEmpty(true);
      triggerToast((error as Error).message || '获取认证状态失败');
    } finally {
      setIsLoading(false);
    }
  }, [authProvider, setUser, triggerToast]);

  // 初始化认证状态
  useEffect(() => {
    if (authProvider) {
      updateAuthState();
    } else {
      setEmpty(true);
    }
  }, [authProvider, updateAuthState]);

  // 事件类型常量
  const AUTH_EVENT_LOGIN = 'login';
  const AUTH_EVENT_LOGOUT = 'logout';
  const AUTH_EVENT_ERROR = 'error';

  // 监听认证事件
  useEffect(() => {
    if (!authProvider) return;
    const handleAuthEvent = (eventType: string, data: AuthEventData) => {
      switch (eventType) {
        case AUTH_EVENT_LOGIN:
          setUser(data.user);
          setEmpty(false);
          triggerToast('登录成功');
          break;
        case AUTH_EVENT_LOGOUT:
          clearAuth();
          setEmpty(true);
          triggerToast('已登出');
          break;
        case AUTH_EVENT_ERROR:
          setError(data.error || new Error('认证异常'));
          triggerToast(data.error?.message || '认证异常');
          break;
        default:
          break;
      }
    };
    eventManager.on('auth', handleAuthEvent);
    return () => {
      eventManager.off('auth', handleAuthEvent);
    };
  }, [authProvider, eventManager, setUser, clearAuth, triggerToast]);

  const allowedProviders = ['google', 'apple', 'wechat'] as const;
  type ProviderType = typeof allowedProviders[number];

  // 登录方法根据 providerType 分流到 IAuthService 的不同方法
  const login = useCallback(async (providerType: ProviderType | 'email' | 'phone', credentials: any) => {
    if (!authProvider) throw new Error('认证服务未初始化');
    setIsLoading(true);
    setError(null);
    try {
      let result: AuthResult;
      if (providerType === 'email') {
        result = await authProvider.loginWithEmail(credentials.email, credentials.password);
      } else if (providerType === 'phone') {
        result = await authProvider.loginWithPhone(credentials.phone, credentials.code);
      } else if (allowedProviders.includes(providerType)) {
        result = await authProvider.loginWithProvider(providerType, credentials.token);
      } else {
        throw new Error('不支持的第三方登录类型');
      }
      setUser(result.user);
      setToken(result.token);
      triggerToast('登录成功');
      return result;
    } catch (error) {
      setError(error as Error);
      triggerToast((error as Error).message || '登录失败');
      throw error;
    } finally {
      setIsLoading(false);
    }
  }, [authProvider, setUser, setToken, triggerToast]);

  // 登出
  const logout = useCallback(async () => {
    if (!authProvider) throw new Error('认证服务未初始化');
    setIsLoading(true);
    setError(null);
    try {
      await authProvider.logout();
      clearAuth();
      triggerToast('已登出');
    } catch (error) {
      setError(error as Error);
      triggerToast((error as Error).message || '登出失败');
      throw error;
    } finally {
      setIsLoading(false);
    }
  }, [authProvider, clearAuth, triggerToast]);

  // 刷新 token
  const refreshToken = useCallback(async () => {
    if (!authProvider) throw new Error('认证服务未初始化');
    setIsLoading(true);
    setError(null);
    try {
      await authProvider.refreshToken();
      triggerToast('Token 已刷新');
      await updateAuthState();
    } catch (error) {
      setError(error as Error);
      triggerToast((error as Error).message || '刷新 token 失败');
      throw error;
    } finally {
      setIsLoading(false);
    }
  }, [authProvider, updateAuthState, triggerToast]);

  return {
    user,
    isAuthenticated: !!user,
    isLoading,
    error,
    enabledMethods,
    empty,
    login,
    logout,
    refreshToken
  };
}
</file>

