// 用户服务工厂，统一为 class + static createService 方法
import { MockUserAdapter } from '../adapters/mock-user-adapter';
import { RemoteUserAdapter } from '../adapters/remote-user-adapter';
import { HybridUserAdapter } from '../adapters/hybrid-user-adapter';
import { IUserService } from '../types/user-service';
import { UserService } from '../service/user-service';

export class UserServiceFactory {
  static createService(
    type?: 'mock'|'remote'|'hybrid',
    apiBaseUrl?: string
  ): IUserService {
    const env = typeof process !== 'undefined' ? process.env.NODE_ENV : 'production';
    let finalType = type;
    if (!finalType) {
      finalType = (env === 'test' || env === 'development') ? 'mock' : 'remote';
    }
    switch (finalType) {
      case 'mock':
        return new UserService(new MockUserAdapter());
      case 'remote':
        if (!apiBaseUrl) throw new Error('apiBaseUrl required for remote user service');
        return new UserService(new RemoteUserAdapter(apiBaseUrl));
      case 'hybrid':
        if (!apiBaseUrl) throw new Error('apiBaseUrl required for hybrid user service');
        return new UserService(new HybridUserAdapter(apiBaseUrl));
      default:
        throw new Error('Unknown user service type: ' + finalType);
    }
  }
}
// 注册表工厂见 registry/user-service-registry.ts
