import { useState, useEffect, useCallback } from 'react';
import { UserServiceRegistry } from '@/core/services/business/user/registry/user-service-registry';
import { useToast } from './useToast';
import { useAuth } from './useAuth';
import type { User } from '@/core/lib/db/types';

export interface UserState {
  user: User | null;
  loading: boolean;
  fetchError: Error | null;
  updateError: Error | null;
  deleteError: Error | null;
  isAuthenticated: boolean;
  empty: boolean;
}

export function useUser(): {
  user: User | null;
  loading: boolean;
  fetchError: Error | null;
  updateError: Error | null;
  deleteError: Error | null;
  isAuthenticated: boolean;
  empty: boolean;
  updateUser: (updates: Partial<User>) => Promise<User>;
  deleteUser: () => Promise<void>;
  reloadUser: () => Promise<void>;
} {
  const { user: authUser, isAuthenticated } = useAuth();
  const [user, setUser] = useState<User | null>(null);
  const [loading, setLoading] = useState(true);
  const [fetchError, setFetchError] = useState<Error | null>(null);
  const [updateError, setUpdateError] = useState<Error | null>(null);
  const [deleteError, setDeleteError] = useState<Error | null>(null);
  const [empty, setEmpty] = useState(false);
  const { triggerToast } = useToast();

  // 自动降级，type 可省略，工厂内部根据环境处理
  const apiBaseUrl = process.env.NEXT_PUBLIC_API_URL;
  // 替换：强制通过注册表获取服务实例，禁止直接工厂实例化
  const userService = UserServiceRegistry.getInstance().createService(
    process.env.NODE_ENV === 'development' ? 'mock' : 'remote',
    apiBaseUrl
  );

  // 加载用户数据
  const loadUser = useCallback(async () => {
    setLoading(true);
    setFetchError(null);
    try {
      const service = UserServiceRegistry.getInstance().getDefaultService();
      const currentUser = await service.getCurrentUser();
      // eslint-disable-next-line no-console
      console.log('[useUser loadUser] Registry.getCurrentUser:', currentUser);
      setUser(currentUser);
      setEmpty(!currentUser);
    } catch (error) {
      const errorObj = error instanceof Error ? error : new Error('获取用户信息失败');
      setFetchError(errorObj);
      setUser(null);
      setEmpty(true);
      triggerToast(errorObj.message);
    } finally {
      setLoading(false);
    }
  }, [authUser, triggerToast]);

  useEffect(() => {
    // eslint-disable-next-line no-console
    console.log('[useUser effect] deps:', { user, loading, fetchError, isAuthenticated });
    loadUser();
  }, [loadUser, user, loading, fetchError, isAuthenticated]);

  // 更新用户数据
  const updateUser = useCallback(async (updates: Partial<User>) => {
    if (!user) {
      const error = new Error('No user to update');
      triggerToast(error.message);
      throw error;
    }
    setLoading(true);
    setUpdateError(null);
    try {
      const updatedUser = await userService.updateUser(user.id, updates);
      setUser(updatedUser);
      setEmpty(!updatedUser);
      triggerToast('用户信息已更新');
      return updatedUser;
    } catch (err) {
      const errorObj = err instanceof Error ? err : new Error('更新用户失败');
      setUpdateError(errorObj);
      triggerToast(errorObj.message);
      throw errorObj;
    } finally {
      setLoading(false);
    }
  }, [user, userService, triggerToast]);

  // 删除用户数据
  const deleteUser = useCallback(async () => {
    if (!user) {
      const error = new Error('No user to delete');
      triggerToast(error.message);
      throw error;
    }
    setLoading(true);
    setDeleteError(null);
    try {
      await userService.deleteUser(user.id);
      setUser(null);
      setEmpty(true);
      triggerToast('用户已删除');
    } catch (err) {
      const errorObj = err instanceof Error ? err : new Error('Failed to delete user');
      setDeleteError(errorObj);
      triggerToast(errorObj.message);
      throw errorObj;
    } finally {
      setLoading(false);
    }
  }, [user, userService, triggerToast]);

  return {
    user,
    loading,
    fetchError,
    updateError,
    deleteError,
    isAuthenticated,
    empty,
    updateUser,
    deleteUser,
    reloadUser: loadUser,
  };
}
</file>

