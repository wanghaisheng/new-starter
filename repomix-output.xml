      );
    }
  }

  /**
   * 查找匹配
   * @param query 查询条件
   * @returns 匹配列表
   */
  async findMatches(query?: any): Promise<Match[]> {
    try {
      const result = await this.query<Match>('matches', { where: query });
      return result.data;
    } catch (error) {
      throw this.createError(
        DatabaseErrorCode.QUERY_ERROR,
        '查询匹配失败',
        error
      );
    }
  }

  /**
   * 查找消息
   * @param query 查询条件
   * @returns 消息列表
   */
