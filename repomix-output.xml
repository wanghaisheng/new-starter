      deleteMessage: vi.fn().mockResolvedValue(undefined),
      markAsRead: vi.fn().mockResolvedValue(true),
    };
    enhancer = {
      beforeSend: vi.fn(async d => d),
      afterSend: vi.fn(async m => m),
