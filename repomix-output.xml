        </IonToolbar>
      </IonHeader>
      
      <IonContent className="bg-[#0f172a]">
        <div className="p-4">
          <p className="text-gray-400 mb-4">
            Manage how and when you receive notifications.
          </p>
        </div>
        
        <IonList lines="full">
          <IonItemGroup>
            <IonItemDivider>
              <IonLabel>
  {t('auto.page.MATCHNO')}
</IonLabel>
            </IonItemDivider>
            
            <IonItem>
              <IonIcon icon={notificationsOutline} slot="start" />
