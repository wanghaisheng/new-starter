            status: 403
          });
        }
        
        // 获取特定匹配的未读消息
        const messages = await messageService.getMessages(matchId);
        const unreadCount = messages.filter(msg => 
          msg.receiverId === userId && msg.status !== 'read'
        ).length;
        
