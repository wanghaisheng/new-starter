  it('should get all users', async () => {
    const userA: User = { ...MOCK_USERS[0], id: 'u6', email: 'unique6@test.com', phone: 'u6' };
    const userB: User = { ...MOCK_USERS[0], id: 'u7', email: 'unique7@test.com', phone: 'u7' };
