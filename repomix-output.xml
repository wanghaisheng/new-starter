  useEffect(() => {
    const apiBaseUrl = process.env.NEXT_PUBLIC_API_URL;
    const env = process.env.NODE_ENV === 'development' ? 'mock' : 'remote';
    serviceRef.current = QuizServiceFactory.createService(env, apiBaseUrl);
    fetchResult();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [userId, quizId]);

  const fetchResult = useCallback(async () => {
    if (!userId || !quizId) return;
    setLoading(true);
    setSubmitError(null);
    setError(null);
    try {
      if (!serviceRef.current) throw new Error('服务未初始化');
      const data = await serviceRef.current.getQuizResult(userId, quizId);
      setResult(data);
      setEmpty(!data);
    } catch (err) {
      const error = err instanceof Error ? err : new Error('Failed to load quiz result');
      setError(error);
      setSubmitError(error);
      setEmpty(true);
      triggerToast(error.message);
    } finally {
      setLoading(false);
    }
  }, [userId, quizId, triggerToast]);

  return { result, loading, submitError, error, empty };
}
