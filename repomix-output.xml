}

interface AnalyticsEvent {
  type: string;
  name: string;
  properties: Record<string, any>;
  timestamp: number;
  userId?: string;
}

interface AnalyticsMetric {
  name: string;
  value: number;
  tags: Record<string, string>;
  timestamp: number;
}

interface AnalyticsReport {
  period: string;
  metrics: Record<string, number>;
  trends: Record<string, TrendData>;
  insights: string[];
