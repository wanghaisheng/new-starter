    /**
     * 最大上传文件大小（字节）
     * @default 10485760 (10MB)
     */
    maxUploadSize?: number;
    
    /**
     * 是否使用 emulator
     * @default false
     */
    useEmulator: boolean;
    
    /**
     * emulator 主机
