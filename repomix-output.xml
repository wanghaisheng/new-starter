  });

  it('should handle bulk inserts efficiently', async () => {
    const startTime = performance.now();
    
    // 批量插入1000条记录
    const entities = Array.from({ length: 1000 }, (_, i) => ({
      id: `perf-${i}`,
      name: `Performance Test ${i}`,
      value: i,
      createdAt: new Date(),
      updatedAt: new Date()
    }));
    
