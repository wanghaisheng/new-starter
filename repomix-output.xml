fi

# 更新标签页重定向文件
echo "更新标签页重定向文件..." >> $RESULTS_FILE

if [ -f "app/mobile/tabs/page.tsx" ]; then
  # 备份原文件
  cp app/mobile/tabs/page.tsx app/mobile/tabs/page.tsx.bak
  echo "✅ 已备份原始标签页重定向文件" >> $RESULTS_FILE
  
