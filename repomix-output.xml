  useEffect(() => {
    let unsub: (() => void) | undefined;
    setLoading(true);
    getUserMessages(userId)
      .then((msgs: Message[]) => { setChats(msgs); setLoading(false); })
      .catch(e => { setError('加载消息失败'); setLoading(false); });
    if (getUserMessages.onMessageChange) {
