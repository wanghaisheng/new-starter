// src/core/lib/db/factory.ts
import { Capacitor } from '@capacitor/core'

export function createDatabaseClient(engine: DatabaseEngine) {
  // 移动端优先使用SQLite
  if (Capacitor.isNativePlatform() && engine === 'indexeddb') {
    engine = 'sqlite'
  }

  switch (engine) {
