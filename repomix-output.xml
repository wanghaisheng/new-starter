export function IonicProvider({ children }: PropsWithChildren) {
  useEffect(() => {
    // 在客户端初始化Ionic
    document.documentElement.classList.add('ion-ce');
  }, []);

  return (
    <IonApp>
      {children}
    </IonApp>
  );
}
