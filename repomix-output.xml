    await expect(mediaRepository.saveMessage({ content: '', type: 'image', senderId: '', receiverId: '', conversationId: '', mediaFile: new Uint8Array(), filename: '', contentType: '', ext: {} })).rejects.toThrow('media save error');
  });
});
