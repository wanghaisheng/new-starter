{
  "compilerOptions": {
    "target": "es2015",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/app/*": ["./app/*"],
      "@core/*": ["./src/core/*"],
      "@mobile/*": ["./src/mobile/*"],
      "@web/*": ["./src/web/*"],
      "@db/*": ["./src/core/lib/db/*"],
      "@db/types/*": ["./src/core/lib/db/types/*"],
      "@db/interfaces/*": ["./src/core/lib/db/interfaces/*"],
      "@db/test/*": ["./src/core/lib/db/test/*"],
      "@/src/*": ["./src/*"],
      "@/src/providers": ["./src/providers/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
